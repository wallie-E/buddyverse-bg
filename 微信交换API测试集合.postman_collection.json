{
  "info": {
    "name": "微信交换功能 API",
    "description": "微信交换功能的完整 API 测试集合",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "targetUserId",
      "value": "2",
      "type": "string"
    },
    {
      "key": "exchangeNo",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. 获取交换信息",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/wechat-exchange/info?targetUserId={{targetUserId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "wechat-exchange", "info"],
          "query": [
            {
              "key": "targetUserId",
              "value": "{{targetUserId}}"
            }
          ]
        },
        "description": "获取与指定用户的微信交换信息"
      },
      "response": []
    },
    {
      "name": "2. 发起交换请求",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    var jsonData = pm.response.json();",
              "    if (jsonData.success && jsonData.data.exchangeNo) {",
              "        pm.collectionVariables.set('exchangeNo', jsonData.data.exchangeNo);",
              "        console.log('Exchange No saved:', jsonData.data.exchangeNo);",
              "    }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"targetUserId\": {{targetUserId}},\n  \"wechatId\": \"my_wechat_123\",\n  \"isUpdate\": false\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/wechat-exchange/request",
          "host": ["{{baseUrl}}"],
          "path": ["api", "wechat-exchange", "request"]
        },
        "description": "向指定用户发起微信交换请求"
      },
      "response": []
    },
    {
      "name": "3. 重新发起交换请求",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"targetUserId\": {{targetUserId}},\n  \"wechatId\": \"my_wechat_123_updated\",\n  \"isUpdate\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/wechat-exchange/request",
          "host": ["{{baseUrl}}"],
          "path": ["api", "wechat-exchange", "request"]
        },
        "description": "重新发起交换请求，更新微信号和时间"
      },
      "response": []
    },
    {
      "name": "4. 确认交换（接受）",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"exchangeNo\": \"{{exchangeNo}}\",\n  \"wechatId\": \"receiver_wechat_456\",\n  \"action\": \"accept\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/wechat-exchange/confirm",
          "host": ["{{baseUrl}}"],
          "path": ["api", "wechat-exchange", "confirm"]
        },
        "description": "接收人确认并接受交换请求"
      },
      "response": []
    },
    {
      "name": "5. 确认交换（拒绝）",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"exchangeNo\": \"{{exchangeNo}}\",\n  \"action\": \"reject\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/wechat-exchange/confirm",
          "host": ["{{baseUrl}}"],
          "path": ["api", "wechat-exchange", "confirm"]
        },
        "description": "接收人拒绝交换请求"
      },
      "response": []
    },
    {
      "name": "6. 获取我的交换记录（全部）",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/wechat-exchange/my-exchanges?page=1&limit=20",
          "host": ["{{baseUrl}}"],
          "path": ["api", "wechat-exchange", "my-exchanges"],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "20"
            }
          ]
        },
        "description": "获取我的所有交换记录"
      },
      "response": []
    },
    {
      "name": "7. 获取我的交换记录（已完成）",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/wechat-exchange/my-exchanges?page=1&limit=20&status=1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "wechat-exchange", "my-exchanges"],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "20"
            },
            {
              "key": "status",
              "value": "1",
              "description": "0-待确认，1-已完成，2-已拒绝"
            }
          ]
        },
        "description": "获取已完成的交换记录"
      },
      "response": []
    },
    {
      "name": "8. 获取通知列表",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/notifications?page=1&limit=20",
          "host": ["{{baseUrl}}"],
          "path": ["api", "notifications"],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "20"
            }
          ]
        },
        "description": "获取通知列表，包含微信交换相关通知"
      },
      "response": []
    },
    {
      "name": "9. 获取未读通知数量",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/notifications/unread-count",
          "host": ["{{baseUrl}}"],
          "path": ["api", "notifications", "unread-count"]
        },
        "description": "获取未读通知数量"
      },
      "response": []
    }
  ]
}

